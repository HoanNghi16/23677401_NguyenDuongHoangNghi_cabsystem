generator client {
    provider = "prisma-client-js"
    output = "../src/generated/prisma"
}

datasource db {
    provider = "postgresql"
}

enum Role {
    CUSTOMER
    DRIVER
    ADMIN
}


model User {
    id          Int         @id @default(autoincrement())
    email       String      @unique
    password    String
    role        Role
    createdAt   DateTime    @default(now())
    updatedAt   DateTime    @updatedAt
}